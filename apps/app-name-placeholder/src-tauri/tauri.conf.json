{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "app-name-placeholder",
  "version": "0.1.0",
  "identifier": "com.author.app-name-placeholder",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run generate",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "app-name-placeholder",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 31
    }
  }
}
